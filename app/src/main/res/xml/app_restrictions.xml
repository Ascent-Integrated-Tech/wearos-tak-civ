                android:description="@string/tak_server_connection_enabled_description"
                android:defaultValue="@string/tak_server_connection_enabled_default" />

            <restriction
                android:key="tak_server_address"
                android:restrictionType="string"
                android:title="@string/tak_server_address_title"
