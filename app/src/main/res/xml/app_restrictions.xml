            <restriction
                android:key="tak_server_username"
                android:restrictionType="string"
                android:title="@string/tak_server_username_title"
                android:description="@string/tak_server_username_description"
                android:defaultValue="@string/tak_server_username_default" />

            <restriction
                android:key="tak_server_password"
                android:restrictionType="string"
                android:title="@string/tak_server_password_title"
                android:description="@string/tak_server_password_description"
                android:defaultValue="@string/tak_server_password_default"/>

            <restriction
                android:key="tak_server_cert_password"
                android:restrictionType="string"
                android:title="@string/tak_server_cert_password_title"
                android:description="@string/tak_server_cert_password_description"
                android:defaultValue="" />

            <restriction
                android:key="tak_server_cert"
                android:restrictionType="string"
                android:title="@string/tak_server_cert_title"
                android:description="@string/tak_server_cert_description"
                android:defaultValue="" />

