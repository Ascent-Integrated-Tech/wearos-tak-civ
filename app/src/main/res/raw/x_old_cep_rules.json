        ]
      }
    },
    {
      "type": "derived",
      "id": "features.motion.active",
      "expr": { "not": { "ref": "features.accel_low_motion" } }
    },
    {
      "type": "derived",
      "id": "features.cold.score",
      "expr": {
        "sum": [
          {
            "case": [
              {
                "lte": [{ "key": "features.skin_temp.hand_min_c_1m" }, 20.0],
                "then": 4
              },
              {
                "lte": [{ "key": "features.skin_temp.hand_min_c_1m" }, 28.0],
                "then": 3
              },
              {
                "lte": [{ "key": "features.skin_temp.hand_min_c_1m" }, 31.0],
                "then": 2
              },
              { "else": 0 }
            ]
          },
          {
            "case": [
              { "ref": "features.shiver_present", "is": true, "then": 2 },
              {
                "and": [
                  { "ref": "features.shiver_present", "is": true },
                  { "gte": [{ "key": "features.shiver_duration_s" }, 30] }
                ],
                "then": 3
              },
              {
                "and": [
                  { "ref": "features.motion.active", "is": false },
                  { "ref": "features.shiver_present", "is": false }
                ],
                "then": 4
              },
              { "else": 0 }
            ]
          },
          {
            "case": [
              { "gte": [{ "key": "features.hr.hrr" }, 0.3], "then": 1 },
              {
                "lte": [{ "key": "features.hr.slope_bpm_per_min_60s" }, 0.0],
                "then": 2
              },
              { "lt": [{ "key": "features.heart_rate" }, 40], "then": 4 },
              { "else": 0 }
            ]
          },
          {
            "case": [
              {
                "gte": [{ "key": "features.hrv.rmssd_drop_ratio" }, 0.2],
                "then": 2
              },
              {
                "gte": [{ "key": "features.hrv.rmssd_drop_ratio" }, 0.3],
                "then": 3
              },
              { "else": 0 }
            ]
          },
          {
            "case": [
              {
                "lte": [{ "key": "features.spo2.delta_pct" }, -3.0],
                "then": 2
              },
              { "ref": "features.ppg.collapse_gt50pct", "is": true, "then": 3 },
              { "else": 0 }
            ]
          },
          {
            "case": [
              { "lte": [{ "key": "features.wind_chill.c" }, -10.0], "then": 2 },
              { "lte": [{ "key": "features.wind_chill.c" }, -27.0], "then": 4 },
              { "else": 0 }
            ]
          }
        ]
      },
      "units": "points"
    },
    {
      "type": "derived",
      "id": "features.cold.risk_state",
      "expr": {
        "categorical": {
          "key": "features.cold.score",
          "bins": [0, 4, 7, 11],
          "labels": ["NORMAL", "WARN", "ALERT", "EMERGENCY"]
        }
      }
    },
    {
      "type": "derived",
      "id": "features.hr.rest_baseline_bpm",
      "expr": { "key": "profile.hr_rest_bpm" },
