  "notes": "Patch file to be merged into existing cep_rules.json. Adds HRV suppression, SpO2/PPG perfusion loss, immersion detection, wind-chill/tactile overrides, HR flattening, ALS coverage, water/humidity corroborator, hand-specific skin temp, HR>HRmax guard, and a cold stress additive score + risk tiers.",
  "merge_instructions": [
    "Append all entries in `features` to your existing features array (ensure unique `id`s).",
    "Append all entries in `rules` to your existing rules array.",
    "If an `id` already exists in your file and you prefer our version, replace it; otherwise rename ours with a suffix."
  ],
  "features": [
    {
      "type": "window",
      "id": "features.hrv.rmssd_recent_1m",
      "source": "hrv.rmssd_ms",
      "op": "avg",
      "window_sec": 60
    },
    {
      "type": "window",
      "id": "features.hrv.rmssd_baseline_24h",
      "source": "hrv.rmssd_ms",
      "op": "avg",
      "window_sec": 86400
    },
    {
      "type": "derived",
      "id": "features.hrv.rmssd_drop_ratio",
      "expr": {
        "div": [
          {
            "sub": [
              { "key": "features.hrv.rmssd_baseline_24h" },
              { "key": "features.hrv.rmssd_recent_1m" }
            ]
          },
          { "max": [1.0, { "key": "features.hrv.rmssd_baseline_24h" }] }
        ]
      },
      "units": "ratio"
    },
    {
      "type": "window",
      "id": "features.spo2.recent_120s",
      "source": "spo2",
      "op": "avg",
      "window_sec": 120
    },
    {
      "type": "window",
      "id": "features.spo2.baseline_86400s",
      "source": "spo2",
      "op": "avg",
      "window_sec": 86400
    },
    {
      "type": "derived",
      "id": "features.spo2.delta_pct",
      "expr": {
        "mul": [
          100,
          {
            "div": [
              {
                "sub": [
                  { "key": "features.spo2.recent_120s" },
                  { "key": "features.spo2.baseline_86400s" }
                ]
              },
              { "max": [0.1, { "key": "features.spo2.baseline_86400s" }] }
            ]
          }
        ]
      },
      "units": "%"
    },
    {
      "type": "window",
      "id": "features.ppg.amplitude_recent_20s",
      "source": "ppg.amplitude",
      "op": "avg",
      "window_sec": 20
    },
    {
      "type": "window",
      "id": "features.ppg.amplitude_baseline_600s",
      "source": "ppg.amplitude",
      "op": "avg",
      "window_sec": 600
    },
    {
      "type": "derived",
      "id": "features.ppg.amplitude_ratio",
      "expr": {
        "div": [
          { "key": "features.ppg.amplitude_recent_20s" },
          { "max": [1e-6, { "key": "features.ppg.amplitude_baseline_600s" }] }
        ]
      },
      "units": "ratio"
    },
    {
      "type": "derived",
      "id": "features.ppg.collapse_gt50pct",
      "expr": { "lte": [{ "key": "features.ppg.amplitude_ratio" }, 0.5] },
      "units": "bool"
    },
    {
      "type": "slope_multi",
      "id": "features.skin_temp.slope_c_per_s_20s",
      "source": "skin_temp",
      "multi_policy": "min_channel",
      "window_sec": 20,
      "units_per_sec": "per_second"
    },
    {
      "type": "window_multi",
      "id": "features.skin_temp.hand_min_c_1m",
      "source": "skin_temp",
      "multi_policy": "min",
      "op": "min",
      "window_sec": 60
    },
    {
      "type": "derived",
      "id": "features.immersion.suspected",
      "expr": {
        "and": [
          { "lte": [{ "key": "features.skin_temp.slope_c_per_s_20s" }, -0.15] },
          { "ref": "features.ppg.collapse_gt50pct", "is": true }
        ]
      }
    },
    {
      "type": "derived",
      "id": "features.wind_chill.c",
      "expr": {
        "wind_chill": {
          "temp_key": "ambient.temp_c",
          "wind_key": "ambient.wind_mps"
        }
      }
    },
    {
      "type": "derived",
      "id": "features.wind_chill.emergency_override",
      "expr": { "lte": [{ "key": "features.wind_chill.c" }, -27.0] },
      "units": "bool"
    },
    {
      "type": "delta",
      "id": "features.hr.delta_60s",
