{
  "schema_version": "1.0",
  "generated_at_utc": "2025-10-10T10:45:28.554495Z",
  "engine": {
    "window_tick_ms": 1000,
    "default_hold_down_sec": 60,
    "clock_skew_tolerance_ms": 250
  },
  "inputs": {
    "heart_rate": {
      "fields": {
        "bpm": "float"
      },
      "meta": {
        "source": "HeartrateService"
      }
    },
    "hrv": {
      "fields": {
        "rmssd_ms": "float",
        "sdnn_ms": "float"
      },
      "meta": {
        "source": "HeartrateService"
      }
    },
    "skin_temp": {
      "fields": {
        "c_peripheral": "float[]",
        "labels": "string[]"
      },
      "meta": {
        "source": "SkinTempService"
      }
    },
    "ambient": {
      "fields": {
        "temp_c": "float",
        "humidity_pct": "float",
        "wind_mps": "float"
      },
      "meta": {
        "source": "EnvSensorService"
      }
    },
    "ppg": {
      "fields": {
        "tremor_power_8_12_hz": "float",
        "contact_quality": "float"
      },
      "meta": {
        "source": "HeartrateService"
      }
    },
    "accel": {
      "fields": {
        "magnitude_g": "float",
        "cadence_spm": "float"
      },
      "meta": {
        "source": "MovementDetectionService"
      }
    },
    "activity": {
      "fields": {
        "state": "enum[STILL,WALKING,RUNNING,DRIVING,UNKNOWN]"
      },
      "meta": {
        "source": "EnhancedMovementClassifier"
      }
    },
    "spo2": {
      "fields": {
        "pct": "float"
      },
      "meta": {
        "source": "HeartrateService"
      }
    },
    "immersion": {
      "fields": {
        "wet_flag": "bool",
        "immersion_flag": "bool"
      },
      "meta": {
        "source": "EnvSensorService"
      }
    },
    "sleep": {
      "fields": {
        "is_sleeping": "bool"
      },
      "meta": {
        "source": "PassiveDataService"
      }
    },
    "offbody": {
      "fields": {
        "on_wrist": "bool"
      },
      "meta": {
        "source": "OffBodyDetectService"
      }
    }
  },
  "personalization": {
    "hr_rest_bpm": {
      "default": 60,
      "update_policy": "rolling_min_30d_rest_only",
      "min_observations": 5
    },
    "hr_max_bpm": {
      "method": "Tanaka_2001",
      "formula": "208 - 0.7*age",
      "fallback": "220 - age",
      "update_policy": "max_observed_30d_during_exercise"
    }
  },
  "features": [
    {
      "id": "features.hr.hrr",
      "type": "derived",
      "expr": {
        "karvonen_ratio": {
          "hr_key": "features.heart_rate",
          "rest_key": "profile.hr_rest_bpm",
          "max_key": "profile.hr_max_bpm",
          "min_den": 1.0
        }
      },
      "units": "ratio"
    },
    {
      "name": "zone_1_min_bpm",
      "type": "compute",
      "expr": "profile.hr_rest_bpm + 0.50*(profile.hr_max_bpm-profile.hr_rest_bpm)",
      "units": "bpm"
    },
    {
      "name": "zone_1_max_bpm",
      "type": "compute",
      "expr": "profile.hr_rest_bpm + 0.60*(profile.hr_max_bpm-profile.hr_rest_bpm)",
      "units": "bpm"
    },
    {
      "name": "zone_1_min_bpm",
      "type": "compute",
      "expr": "profile.hr_rest_bpm + 0.5*(profile.hr_max_bpm-profile.hr_rest_bpm)",
      "units": "bpm"
    },
    {
      "name": "zone_1_max_bpm",
      "type": "compute",
      "expr": "profile.hr_rest_bpm + 0.6*(profile.hr_max_bpm-profile.hr_rest_bpm)",
      "units": "bpm"
    },
    {
      "name": "zone_2_min_bpm",
      "type": "compute",
      "expr": "profile.hr_rest_bpm + 0.6*(profile.hr_max_bpm-profile.hr_rest_bpm)",
      "units": "bpm"
    },
    {
      "name": "zone_2_max_bpm",
      "type": "compute",
      "expr": "profile.hr_rest_bpm + 0.7*(profile.hr_max_bpm-profile.hr_rest_bpm)",
      "units": "bpm"
    },
    {
      "name": "zone_3_min_bpm",
      "type": "compute",
      "expr": "profile.hr_rest_bpm + 0.7*(profile.hr_max_bpm-profile.hr_rest_bpm)",
      "units": "bpm"
    },
    {
      "name": "zone_3_max_bpm",
      "type": "compute",
      "expr": "profile.hr_rest_bpm + 0.8*(profile.hr_max_bpm-profile.hr_rest_bpm)",
      "units": "bpm"
    },
    {
      "name": "zone_4_min_bpm",
      "type": "compute",
      "expr": "profile.hr_rest_bpm + 0.8*(profile.hr_max_bpm-profile.hr_rest_bpm)",
      "units": "bpm"
    },
    {
      "name": "zone_4_max_bpm",
      "type": "compute",
      "expr": "profile.hr_rest_bpm + 0.9*(profile.hr_max_bpm-profile.hr_rest_bpm)",
      "units": "bpm"
    },
    {
      "name": "zone_5_min_bpm",
      "type": "compute",
      "expr": "profile.hr_rest_bpm + 0.9*(profile.hr_max_bpm-profile.hr_rest_bpm)",
      "units": "bpm"
    },
    {
      "name": "zone_5_max_bpm",
      "type": "compute",
      "expr": "profile.hr_rest_bpm + 1.0*(profile.hr_max_bpm-profile.hr_rest_bpm)",
      "units": "bpm"
    },
    {
      "name": "skin_temp_min_c_1m",
      "type": "window",
      "source": "skin_temp.c_peripheral",
      "agg": "min",
      "window_sec": 60,
      "multi_policy": "min"
    },
    {
      "name": "skin_temp_min_c_5m",
      "type": "window",
      "source": "skin_temp.c_peripheral",
      "agg": "min",
      "window_sec": 300,
      "multi_policy": "min"
    },
    {
      "name": "skin_temp_slope_c_per_min_5m",
      "type": "slope",
      "source": "skin_temp.c_peripheral",
      "window_sec": 300,
      "units": "\u00b0C/min",
      "multi_policy": "min_channel_slope"
    },
    {
      "name": "accel_low_motion",
      "type": "threshold",
      "expr": "accel.magnitude_g <= 0.05",
      "units": "bool"
    },
    {
      "name": "shiver_power_z",
      "type": "zscore",
      "source": "ppg.tremor_power_8_12_hz",
      "window_sec": 120
    },
    {
      "name": "shiver_present",
      "type": "threshold",
      "expr": "features.shiver_power_z >= 3.0",
      "units": "bool"
    },
    {
      "name": "cold_environment",
      "type": "logic",
      "expr": "(ambient.temp_c <= 5) or (features.wind_chill_c <= 0) or (immersion.immersion_flag == true)"
    },
    {
      "name": "wind_chill_c",
      "type": "compute",
      "expr": "13.12 + 0.6215*ambient.temp_c - 11.37*(max(0,ambient.wind_mps)*3.6)**0.16 + 0.3965*ambient.temp_c*(max(0,ambient.wind_mps)*3.6)**0.16",
      "units": "\u00b0C",
      "note": "Canadian wind chill formula; wind_mps converted to km/h"
    },
    {
      "name": "tactile_loss_risk",
      "type": "threshold",
      "expr": "(features.skin_temp_min_c_1m <= 15) or (features.skin_temp_min_c_1m <= 8)",
      "units": "bool"
    },
    {
      "name": "absent_shiver_in_cold",
      "type": "logic",
      "expr": "(features.cold_environment) and (features.skin_temp_min_c_5m <= 28) and (not features.shiver_present)"
    },
    {
      "name": "poor_recovery_2min",
      "type": "delta",
      "source": "heart_rate.bpm",
      "window_sec": 120,
      "cmp": "drop",
      "units": "bpm",
      "note": "Positive values mean HR drop in 2 min window"
    }
  ],
  "rulesets": [
    {
      "name": "heartrate_exertion",
      "context": "hr_exertion",
      "rules": [
        {
          "id": "bradycardia_rest_alert",
          "severity": "ALERT",
          "when": {
            "all": [
              {
                "ref": "accel_low_motion",
                "is": true
              },
              {
                "gte": {
                  "feature": "sleep.is_sleeping",
                  "value": null
                }
              },
              {
                "lte": {
                  "feature": "heart_rate.bpm",
                  "value": 40
                }
              },
              {
                "sustained_for_sec": 600
              }
            ]
          },
          "message": "Bradycardia at rest: HR \u2264 40 bpm for \u2265 10 min (not sleeping).",
          "tags": [
            "hr",
            "rest",
            "bradycardia"
          ],
          "action": {
            "type": "log",
            "level": "WARN"
          }
        },
        {
          "id": "tachycardia_rest_warn",
          "severity": "WARN",
          "when": {
            "all": [
              {
                "ref": "accel_low_motion",
                "is": true
              },
              {
                "any": [
                  {
                    "gte": {
                      "feature": "heart_rate.bpm",
                      "value": 100
                    }
                  },
                  {
                    "gte": {
                      "feature": "heart_rate.bpm",
                      "value_ref_ratio": [
                        "profile.hr_rest_bpm",
                        1.2
                      ]
                    }
                  }
                ]
              },
              {
                "sustained_for_sec": 600
              }
            ]
          },
          "message": "Elevated HR at rest for 10 min (\u2265100 bpm or \u226520% above rest).",
          "tags": [
            "hr",
            "rest",
            "tachycardia"
          ],
          "action": {
            "type": "log",
            "level": "INFO"
          }
        },
        {
          "id": "no_motion_high_hr_immediate",
          "severity": "ALERT",
          "when": {
            "all": [
              {
                "ref": "accel_low_motion",
                "is": true
              },
              {
                "between": {
                  "feature": "heart_rate.bpm",
                  "min_ref": "zone_4_min_bpm",
                  "max_ref": "zone_5_max_bpm"
                }
              }
            ]
          },
          "message": "High HR with no motion (Zone 4\u20135, immediate). Possible stress/illness.",
          "tags": [
            "hr",
            "no_motion"
          ],
          "action": {
            "type": "log",
            "level": "WARN"
          }
        },
        {
          "id": "zone4_sustained_alert",
          "severity": "ALERT",
          "when": {
            "all": [
              {
                "gte": {
                  "feature": "heart_rate.bpm",
                  "value_ref": "zone_4_min_bpm"
                }
              },
              {
                "lt": {
                  "feature": "heart_rate.bpm",
                  "value_ref": "zone_5_min_bpm"
                }
              },
              {
                "sustained_for_sec": 600
              }
            ]
          },
          "message": "Zone 4 sustained > 10 min.",
          "tags": [
            "hr",
            "exercise",
            "zone4"
          ],
          "action": {
            "type": "log",
            "level": "INFO"
          }
        },
        {
          "id": "zone5_duration_alert",
          "severity": "ALERT",
          "when": {
            "all": [
              {
                "gte": {
                  "feature": "heart_rate.bpm",
                  "value_ref": "zone_5_min_bpm"
                }
              },
              {
                "sustained_for_sec": 600
              }
            ]
          },
          "message": "Zone 5 > 10 min \u2014 check intensity/fatigue.",
          "tags": [
            "hr",
            "exercise",
            "zone5"
          ],
          "action": {
            "type": "log",
            "level": "WARN"
          }
        },
        {
          "id": "poor_recovery_warn",
          "severity": "WARN",
          "when": {
            "all": [
              {
                "recently_in": {
                  "feature": "heart_rate.bpm",
                  "min_ref": "zone_4_min_bpm",
                  "duration_sec": 120
                }
              },
              {
                "lt": {
                  "feature": "features.poor_recovery_2min",
                  "value": 20
                }
              }
            ]
          },
          "message": "Poor HR recovery: <20 bpm drop in 2 min after exertion.",
          "tags": [
            "hr",
            "recovery"
          ],
          "action": {
            "type": "log",
            "level": "INFO"
          }
        }
      ]
    },
    {
      "name": "cold_stress",
      "context": "cold",
      "rules": [
        {
          "id": "cold_warn_fast_cooling",
          "severity": "WARN",
          "when": {
            "all": [
              {
                "lte": {
                  "feature": "features.skin_temp_slope_c_per_min_5m",
                  "value": -0.5
                }
              },
              {
                "ref": "cold_environment",
                "is": true
              }
            ]
          },
          "message": "Cold Stress: rapid peripheral cooling (slope \u2264 \u22120.5 \u00b0C/min over 5 min).",
          "tags": [
            "cold",
            "slope"
          ],
          "action": {
            "type": "log",
            "level": "INFO"
          }
        },
        {
          "id": "cold_alert_skin_lt_28",
          "severity": "ALERT",
          "when": {
            "all": [
              {
                "lte": {
                  "feature": "features.skin_temp_min_c_1m",
                  "value": 28
                }
              },
              {
                "sustained_for_sec": 60
              }
            ]
          },
          "message": "Cold Stress: Skin \u2264 28 \u00b0C sustained.",
          "tags": [
            "cold",
            "threshold"
          ],
          "action": {
            "type": "log",
            "level": "WARN"
          }
        },
        {
          "id": "cold_emergency_skin_lt_20",
          "severity": "EMERGENCY",
          "when": {
            "all": [
              {
                "lte": {
                  "feature": "features.skin_temp_min_c_1m",
                  "value": 20
                }
              },
              {
                "sustained_for_sec": 30
              }
            ]
          },
          "message": "Cold Emergency: Skin \u2264 20 \u00b0C (loss of dexterity, frostbite risk).",
          "tags": [
            "cold",
            "emergency"
          ],
          "action": {
            "type": "log",
            "level": "ERROR"
          }
        },
        {
          "id": "cold_emergency_absent_shiver",
          "severity": "EMERGENCY",
          "when": {
            "all": [
              {
                "ref": "absent_shiver_in_cold",
                "is": true
              },
              {
                "sustained_for_sec": 120
              }
            ]
          },
          "message": "Cold Emergency: Absent shiver despite cold (autonomic failure).",
          "tags": [
            "cold",
            "shiver",
            "emergency"
          ],
          "action": {
            "type": "log",
            "level": "ERROR"
          }
        },
        {
          "id": "cold_warn_tactile_risk",
          "severity": "WARN",
          "when": {
            "any": [
              {
                "lte": {
                  "feature": "features.skin_temp_min_c_1m",
                  "value": 15
                }
              },
              {
                "lte": {
                  "feature": "features.skin_temp_min_c_1m",
                  "value": 8
                }
              }
            ]
          },
          "message": "Dexterity/Tactile risk: peripheral skin \u2264 15 \u00b0C (\u22648 \u00b0C tactile failure).",
          "tags": [
            "cold",
            "dexterity"
          ],
          "action": {
            "type": "log",
            "level": "INFO"
          }
        }
      ]
    }
  ]
}