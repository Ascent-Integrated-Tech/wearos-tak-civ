{
  "schema_version": "1.0",
  "generated_at_utc": "2025-10-10T10:45:28.554495Z",
  "engine": {
    "window_tick_ms": 1000,
    "default_hold_down_sec": 60,
    "clock_skew_tolerance_ms": 250
  },
  "inputs": {
    "heart_rate": {
      "fields": { "bpm": "float" },
      "meta": { "source": "HeartrateService" }
    },
    "hrv": {
      "fields": { "rmssd_ms": "float", "sdnn_ms": "float" },
      "meta": { "source": "HeartrateService" }
    },
    "skin_temp": {
      "fields": { "c_peripheral": "float[]", "labels": "string[]" },
      "meta": { "source": "SkinTempService" }
    },
    "ambient": {
      "fields": { "temp_c": "float", "humidity_pct": "float", "wind_mps": "float" },
      "meta": { "source": "EnvSensorService" }
    },
    "ppg": {
      "fields": { "tremor_power_8_12_hz": "float", "contact_quality": "float" },
      "meta": { "source": "HeartrateService" }
    },
    "accel": {
      "fields": { "magnitude_g": "float", "cadence_spm": "float" },
      "meta": { "source": "MovementDetectionService" }
    },
    "activity": {
      "fields": { "state": "enum[STILL,WALKING,RUNNING,DRIVING,UNKNOWN]" },
      "meta": { "source": "EnhancedMovementClassifier" }
    },
    "spo2": {
      "fields": { "pct": "float" },
      "meta": { "source": "HeartrateService" }
    },
    "immersion": {
      "fields": { "wet_flag": "bool", "immersion_flag": "bool" },
      "meta": { "source": "EnvSensorService" }
    },
    "sleep": {
      "fields": { "is_sleeping": "bool" },
      "meta": { "source": "PassiveDataService" }
    },
    "offbody": {
      "fields": { "on_wrist": "bool" },
      "meta": { "source": "OffBodyDetectService" }
    }
  },
  "personalization": {
    "hr_rest_bpm": {
      "default": 60,
      "update_policy": "rolling_min_30d_rest_only",
      "min_observations": 5
    },
    "hr_max_bpm": {
      "method": "Tanaka_2001",
      "formula": "208 - 0.7*age",
      "fallback": "220 - age",
      "update_policy": "max_observed_30d_during_exercise"
    }
  },
  "features": [
    {
      "id": "features.hr.hrr",
      "type": "derived",
      "expr": {
        "karvonen_ratio": {
          "hr_key": "heart_rate.bpm",
          "rest_key": "profile.hr_rest_bpm",
          "max_key": "profile.hr_max_bpm",
          "min_den": 1.0
        }
      },
      "units": "ratio"
    },

    { "id": "features.skin_temp_min_c_1m", "type": "window",
      "source": "skin_temp.c_peripheral", "agg": "min", "window_sec": 60, "multi_policy": "min" },

    { "id": "features.skin_temp_min_c_5m", "type": "window",
      "source": "skin_temp.c_peripheral", "agg": "min", "window_sec": 300, "multi_policy": "min" },

    {
      "id": "features.skin_temp_slope_c_per_min_5m",
      "type": "slope",
      "expr": {
        "slope": {
          "source_key": "skin_temp.c_peripheral",
          "horizon_sec": 300,
          "units_per": "min",
          "multi_policy": "min_channel_slope"
        }
      },
      "units": "°C/min"
    },

    {
      "id": "features.accel_low_motion",
      "type": "threshold",
      "expr": { "lte_key": ["accel.magnitude_g", 0.05] },
      "units": "bool"
    },

    { "id": "features.shiver_power_z", "type": "zscore",
      "source": "ppg.tremor_power_8_12_hz", "window_sec": 120 },

    {
      "id": "features.shiver_present",
      "type": "threshold",
      "expr": { "gte_key": ["features.shiver_power_z", 3.0] },
      "units": "bool"
    },

    {
      "id": "features.wind_chill_c",
      "type": "compute",
      "expr": { "wind_chill": { "temp_key": "ambient.temp_c", "wind_key": "ambient.wind_mps" } },
      "units": "°C",
      "note": "Canadian wind chill formula; wind_mps converted to km/h"
    },

    {
      "id": "features.cold_environment",
      "type": "logic",
      "expr": {
        "or": [
          { "lte_key": ["ambient.temp_c", 5] },
          { "lte_key": ["features.wind_chill_c", 0] },
          { "eq_key": ["immersion.immersion_flag", true] }
        ]
      }
    },

    {
      "id": "features.tactile_loss_risk",
      "type": "logic",
      "expr": {
        "or": [
          { "lte_key": ["features.skin_temp_min_c_1m", 15] },
          { "lte_key": ["features.skin_temp_min_c_1m", 8] }
        ]
      },
      "units": "bool"
    },

    {
      "id": "features.absent_shiver_in_cold",
      "type": "logic",
      "expr": {
        "and": [
          { "ref": "features.cold_environment", "is": true },
          { "lte_key": ["features.skin_temp_min_c_5m", 28] },
          { "not": { "ref": "features.shiver_present", "is": true } }
        ]
      }
    },

    {
      "id": "features.poor_recovery_2min",
      "type": "delta",
      "source": "heart_rate.bpm",
      "window_sec": 120,
      "cmp": "drop",
      "units": "bpm",
      "note": "Positive values mean HR drop in 2 min window"
    }
  ],
  "rulesets": [
    {
      "name": "heartrate_exertion",
      "context": "hr_exertion",
      "rules": [
        {
          "id": "bradycardia_rest_alert",
          "severity": "ALERT",
          "when": {
            "all": [
              { "ref": "features.accel_low_motion", "is": true },
              { "eq_key": ["sleep.is_sleeping", false] },
              { "lte_key": ["heart_rate.bpm", 40] },
              { "sustained_for_sec": 600 }
            ]
          },
          "message": "Bradycardia at rest: HR ≤ 40 bpm for ≥ 10 min (not sleeping).",
          "tags": ["hr","rest","bradycardia"],
          "action": { "type": "log", "level": "WARN" }
        },

        {
          "id": "tachycardia_rest_warn",
          "severity": "WARN",
          "when": {
            "all": [
              { "ref": "features.accel_low_motion", "is": true },
              {
                "or": [
                  { "gte_key": ["heart_rate.bpm", 100] },
                  { "gte_ratio": ["heart_rate.bpm", "profile.hr_rest_bpm", 1.2] }
                ]
              },
              { "sustained_for_sec": 600 }
            ]
          },
          "message": "Elevated HR at rest for 10 min (≥100 bpm or ≥20% above rest).",
          "tags": ["hr","rest","tachycardia"],
          "action": { "type": "log", "level": "INFO" }
        },

        {
          "id": "no_motion_high_hr_immediate",
          "severity": "ALERT",
          "when": {
            "all": [
              { "ref": "features.accel_low_motion", "is": true },
              { "between_ratio": ["features.hr.hrr", 0.8, 1.0] }
            ]
          },
          "message": "High HR with no motion (HRR in Zone 4–5 range, immediate). Possible stress/illness.",
          "tags": ["hr","no_motion"],
          "action": { "type": "log", "level": "WARN" }
        },

        {
          "id": "zone4_sustained_alert",
          "severity": "ALERT",
          "when": {
            "all": [
              { "between_ratio": ["features.hr.hrr", 0.8, 0.9] },
              { "sustained_for_sec": 600 }
            ]
          },
          "message": "Zone 4 sustained > 10 min.",
          "tags": ["hr","exercise","zone4"],
          "action": { "type": "log", "level": "INFO" }
        },

        {
          "id": "zone5_duration_alert",
          "severity": "ALERT",
          "when": {
            "all": [
              { "gte_key": ["features.hr.hrr", 0.9] },
              { "sustained_for_sec": 600 }
            ]
          },
          "message": "Zone 5 > 10 min — check intensity/fatigue.",
          "tags": ["hr","exercise","zone5"],
          "action": { "type": "log", "level": "WARN" }
        },

        {
          "id": "poor_recovery_warn",
          "severity": "WARN",
          "when": {
            "all": [
              { "recently_ratio_at_least": ["features.hr.hrr", 0.8, 120] },
              { "lt_key": ["features.poor_recovery_2min", 20] }
            ]
          },
          "message": "Poor HR recovery: <20 bpm drop in 2 min after exertion.",
          "tags": ["hr","recovery"],
          "action": { "type": "log", "level": "INFO" }
        }
      ]
    },

    {
      "name": "cold_stress",
      "context": "cold",
      "rules": [
        {
          "id": "cold_warn_fast_cooling",
          "severity": "WARN",
          "when": {
            "all": [
              { "lte_key": ["features.skin_temp_slope_c_per_min_5m", -0.5] },
              { "ref": "features.cold_environment", "is": true }
            ]
          },
          "message": "Cold Stress: rapid peripheral cooling (slope ≤ −0.5 °C/min over 5 min).",
          "tags": ["cold","slope"],
          "action": { "type": "log", "level": "INFO" }
        },

        {
          "id": "cold_alert_skin_lt_28",
          "severity": "ALERT",
          "when": {
            "all": [
              { "lte_key": ["features.skin_temp_min_c_1m", 28] },
              { "sustained_for_sec": 60 }
            ]
          },
          "message": "Cold Stress: Skin ≤ 28 °C sustained.",
          "tags": ["cold","threshold"],
          "action": { "type": "log", "level": "WARN" }
        },

        {
          "id": "cold_emergency_skin_lt_20",
          "severity": "EMERGENCY",
          "when": {
            "all": [
              { "lte_key": ["features.skin_temp_min_c_1m", 20] },
              { "sustained_for_sec": 30 }
            ]
          },
          "message": "Cold Emergency: Skin ≤ 20 °C (loss of dexterity, frostbite risk).",
          "tags": ["cold","emergency"],
          "action": { "type": "log", "level": "ERROR" }
        },

        {
          "id": "cold_emergency_absent_shiver",
          "severity": "EMERGENCY",
          "when": {
            "all": [
              { "ref": "features.absent_shiver_in_cold", "is": true },
              { "sustained_for_sec": 120 }
            ]
          },
          "message": "Cold Emergency: Absent shiver despite cold (autonomic failure).",
          "tags": ["cold","shiver","emergency"],
          "action": { "type": "log", "level": "ERROR" }
        },

        {
          "id": "cold_warn_tactile_risk",
          "severity": "WARN",
          "when": {
            "any": [
              { "lte_key": ["features.skin_temp_min_c_1m", 15] },
              { "lte_key": ["features.skin_temp_min_c_1m", 8] }
            ]
          },
          "message": "Dexterity/Tactile risk: peripheral skin ≤ 15 °C (≤8 °C tactile failure).",
          "tags": ["cold","dexterity"],
          "action": { "type": "log", "level": "INFO" }
        }
      ]
    }
  ]
}
