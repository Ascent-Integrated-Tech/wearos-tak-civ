            "hysteresis": 2.0
          },
          {
            "feature": "offbody.on_wrist",
            "exit_below": 0.5,
            "exit_above": null,
            "hysteresis": 0.0
          }
        ],
        "exit_logic": "OR",
        "exit_sustain_sec": 3
      }
    },
