{
  "schema_version": "1.0",
  "generated_at_utc": "2025-10-10T10:45:28.554495Z",
  "engine": {
    "window_tick_ms": 1000,
    "default_hold_down_sec": 60,
    "clock_skew_tolerance_ms": 250
  },

  "features": [
    {
      "id": "features.hr.hrr",
      "type": "derived",
      "expr": {
        "karvonen_ratio": {
          "hr_key": "heart_rate.bpm",
          "rest_key": "profile.hr_rest_bpm",
          "max_key": "profile.hr_max_bpm",
          "min_den": 1.0
        }
      },
      "units": "ratio"
    },

    {
      "id": "features.skin_temp_min_c_1m",
      "type": "window_multi",
      "source": "skin_temp.c_peripheral",
      "multi_policy": "min",
      "agg": "min",
      "window_sec": 60
    },
    {
      "id": "features.skin_temp_min_c_5m",
      "type": "window_multi",
      "source": "skin_temp.c_peripheral",
      "multi_policy": "min",
      "agg": "min",
      "window_sec": 300
    },

    {
      "id": "features.skin_temp_slope_c_per_min_5m",
      "type": "slope",
      "expr": {
        "slope": {
          "source_key": "skin_temp.c_peripheral",
          "horizon_sec": 300,
          "per": "min",
          "multi_policy": "min_channel_slope"
        }
      },
      "units": "°C/min"
    },

    {
      "id": "features.accel_low_motion",
      "type": "threshold",
      "expr": { "lte_key": ["accel.magnitude_g", 0.05] },
      "units": "bool"
    },

    {
      "id": "features.shiver_power_z",
      "type": "derived",
      "expr": {
        "zscore": {
          "source_key": "ppg.tremor_power_8_12_hz",
          "window_sec": 120
        }
      }
    },
    {
      "id": "features.shiver_present",
      "type": "threshold",
      "expr": { "gte_key": ["features.shiver_power_z", 3.0] },
      "units": "bool"
    },

    {
      "id": "features.wind_chill_c",
      "type": "compute",
      "expr": {
        "wind_chill": {
          "temp_key": "ambient.temp_c",
          "wind_key": "ambient.wind_mps"
        }
      },
      "units": "°C",
      "note": "Canadian wind chill; converts m/s → km/h internally"
    },

    {
      "id": "features.cold_environment",
      "type": "logic",
      "expr": {
        "or": [
          { "lte_key": ["ambient.temp_c", 5] },
          { "lte_key": ["features.wind_chill_c", 0] },
          { "eq_key": ["immersion.immersion_flag", true] }
        ]
      }
    },

    {
      "id": "features.tactile_loss_risk",
      "type": "logic",
      "expr": {
        "or": [
          { "lte_key": ["features.skin_temp_min_c_1m", 15] },
          { "lte_key": ["features.skin_temp_min_c_1m", 8] }
        ]
      },
      "units": "bool"
    },

    {
      "id": "features.absent_shiver_in_cold",
      "type": "logic",
      "expr": {
        "and": [
          { "ref": "features.cold_environment", "is": true },
          { "lte_key": ["features.skin_temp_min_c_5m", 28] },
          { "not": { "ref": "features.shiver_present", "is": true } }
        ]
      }
    },

    {
      "id": "features.poor_recovery_2min",
      "type": "delta",
      "source": "heart_rate.bpm",
      "horizon_sec": 120,
      "units": "bpm",
      "note": "Positive values mean HR drop in 2 min window"
    }
  ],

  "rules": [
    {
      "id": "bradycardia_rest_alert",
      "when": {
        "all": [
          { "ref": "features.accel_low_motion", "is": true },
          { "eq_key": ["sleep.is_sleeping", false] },
          { "lte_key": ["heart_rate.bpm", 40] }
        ]
      },
      "sustained_for_sec": 600,
      "action": {
        "type": "log",
        "severity": "ALERT",
        "message": "Bradycardia at rest: HR ≤ 40 bpm for ≥ 10 min (not sleeping).",
        "tags": ["hr", "rest", "bradycardia"]
      }
    },

    {
      "id": "tachycardia_rest_warn",
      "when": {
        "all": [
          { "ref": "features.accel_low_motion", "is": true },
          {
            "or": [
              { "gte_key": ["heart_rate.bpm", 100] },
              { "gte_key": ["heart_rate.bpm", { "ref": "profile.hr_rest_bpm", "ratio": 1.2 }] }
            ]
          }
        ]
      },
      "sustained_for_sec": 600,
      "action": {
        "type": "log",
        "severity": "WARN",
        "message": "Elevated HR at rest for 10 min (≥100 bpm or ≥20% above rest).",
        "tags": ["hr", "rest", "tachycardia"]
      }
    },

    {
      "id": "no_motion_high_hr_immediate",
      "when": {
        "all": [
          { "ref": "features.accel_low_motion", "is": true },
          { "gte_key": ["features.hr.hrr", 0.8] }  // Zone 4–5 region
        ]
      },
      "action": {
        "type": "log",
        "severity": "ALERT",
        "message": "High HR with no motion (HRR in Zone 4–5 range, immediate). Possible stress/illness.",
        "tags": ["hr", "no_motion"]
      }
    },

    {
      "id": "zone4_sustained_alert",
      "when": {
        "all": [
          { "gte_key": ["features.hr.hrr", 0.8] },
          { "lt_key": ["features.hr.hrr", 0.9] }
        ]
      },
      "sustained_for_sec": 600,
      "action": {
        "type": "log",
        "severity": "ALERT",
        "message": "Zone 4 sustained > 10 min.",
        "tags": ["hr", "exercise", "zone4"]
      }
    },

    {
      "id": "zone5_duration_alert",
      "when": { "gte_key": ["features.hr.hrr", 0.9] },
      "sustained_for_sec": 600,
      "action": {
        "type": "log",
        "severity": "ALERT",
        "message": "Zone 5 > 10 min — check intensity/fatigue.",
        "tags": ["hr", "exercise", "zone5"]
      }
    },

    {
      "id": "poor_recovery_warn",
      "when": {
        "all": [
          { "recently_in": ["features.hr.hrr", 0.8, 120] },
          { "lt_key": ["features.poor_recovery_2min", 20] }
        ]
      },
      "action": {
        "type": "log",
        "severity": "WARN",
        "message": "Poor HR recovery: <20 bpm drop in 2 min after exertion.",
        "tags": ["hr", "recovery"]
      }
    },

    {
      "id": "cold_warn_fast_cooling",
      "when": {
        "all": [
          { "lte_key": ["features.skin_temp_slope_c_per_min_5m", -0.5] },
          { "ref": "features.cold_environment", "is": true }
        ]
      },
      "action": {
        "type": "log",
        "severity": "WARN",
        "message": "Cold Stress: rapid peripheral cooling (slope ≤ −0.5 °C/min over 5 min).",
        "tags": ["cold", "slope"]
      }
    },

    {
      "id": "cold_alert_skin_lt_28",
      "when": { "lte_key": ["features.skin_temp_min_c_1m", 28] },
      "sustained_for_sec": 60,
      "action": {
        "type": "log",
        "severity": "ALERT",
        "message": "Cold Stress: Skin ≤ 28 °C sustained.",
        "tags": ["cold", "threshold"]
      }
    },

    {
      "id": "cold_emergency_skin_lt_20",
      "when": { "lte_key": ["features.skin_temp_min_c_1m", 20] },
      "sustained_for_sec": 30,
      "action": {
        "type": "log",
        "severity": "EMERGENCY",
        "message": "Cold Emergency: Skin ≤ 20 °C (loss of dexterity, frostbite risk).",
        "tags": ["cold", "emergency"]
      }
    },

    {
      "id": "cold_emergency_absent_shiver",
      "when": { "ref": "features.absent_shiver_in_cold", "is": true },
      "sustained_for_sec": 120,
      "action": {
        "type": "log",
        "severity": "EMERGENCY",
        "message": "Cold Emergency: Absent shiver despite cold (autonomic failure).",
        "tags": ["cold", "shiver", "emergency"]
      }
    },

    {
      "id": "cold_warn_tactile_risk",
      "when": {
        "or": [
          { "lte_key": ["features.skin_temp_min_c_1m", 15] },
          { "lte_key": ["features.skin_temp_min_c_1m", 8] }
        ]
      },
      "action": {
        "type": "log",
        "severity": "WARN",
        "message": "Dexterity/Tactile risk: peripheral skin ≤ 15 °C (≤8 °C tactile failure).",
        "tags": ["cold", "dexterity"]
      }
    }
  ]
}

