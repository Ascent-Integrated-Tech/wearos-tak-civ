        <!-- WEAR-508: app-level ManagedConfiguration CEP overlay receiver.
             Listens for ACTION_APPLICATION_RESTRICTIONS_CHANGED outside of MainActivity so
             the overlay can be applied without an activity. exported=true is required because
             the broadcast is delivered by the system process. -->
        <receiver
            android:name=".integration.managedconfig.CepManagedConfigReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_RESTRICTIONS_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".integration.plugin.PluginOverlayReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="${applicationId}.permission.PLUGIN_BROADCAST">
            <intent-filter>
                <action android:name="com.aitech.weartak_civ.PLUGIN_OVERLAY" />
                <action android:name="com.aitech.weartak_civ.PLUGIN_UNREGISTER" />
            </intent-filter>
        </receiver>

        <!-- WEAR-509: plugin sample ingest. Design action name is PLUGIN_SAMPLE; the legacy
             PLUGIN_INGEST action is retained temporarily for backward compatibility with
             plugins that still publish against the older name. -->
        <receiver
            android:name=".integration.plugin.PluginIngestReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="${applicationId}.permission.PLUGIN_BROADCAST">
            <intent-filter>
                <action android:name="com.aitech.weartak_civ.PLUGIN_SAMPLE" />
                <action android:name="com.aitech.weartak_civ.PLUGIN_INGEST" />
            </intent-filter>
        </receiver>

        <!-- WEAR-509: package uninstall triggers plugin eviction + recompose (design §540). -->
        <receiver
            android:name=".integration.plugin.PluginPackageRemovedReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_PACKAGE_REMOVED">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
        <receiver
